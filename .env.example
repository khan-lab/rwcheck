# ── rwcheck — environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in the values before running:
#   cp .env.example .env

# Email address used by Let's Encrypt for certificate notifications.
# REQUIRED — replace with a real address before deploying.
ACME_EMAIL=admin@khanlab.bio

# Source URL for the Retraction Watch CSV dataset.
# Default points to the official Crossref/GitLab mirror.
RW_CSV_URL=https://gitlab.com/crossref/retraction-watch-data/-/raw/main/retraction_watch.csv

# REST API rate limit per IP (slowapi syntax: N/period).
# Examples: 60/minute  120/minute  1000/hour
RATE_LIMIT=60/minute

# How often the background scheduler re-downloads and rebuilds the DB.
UPDATE_INTERVAL_HOURS=24

# Public base URL shown in the landing page API examples.
# Set to your domain when deploying (no trailing slash).
PUBLIC_HOST=https://rwcheck.khanlab.bio
